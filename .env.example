# LINE Messaging API (ใช้ส่งคำขอจองจาก booking form เข้า LINE group)
# หาได้จาก LINE Developers Console > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=Cafe09fb68d4d8f485d07f2bf24cb8330
LINE_CHANNEL_SECRET=

# ชื่อเดิม (ยังรองรับอยู่เพื่อไม่ให้ .env ปัจจุบันพัง)
# ACCESS_KEY_ID = เดียวกับ LINE_CHANNEL_ACCESS_TOKEN
# GROUP_ID     = เดียวกับ LINE_GROUP_ID
# CHANEL_SECET_KEY = เดียวกับ LINE_CHANNEL_SECRET
CHANEL_SECET_KEY=
ACCESS_KEY_ID=
GROUP_ID=Cafe09fb68d4d8f485d07f2bf24cb8330

# Webhook เสริม (ไม่บังคับ) เช่น Google Sheet / Slack / อื่นๆ
# ถ้าตั้งไว้ ระบบจะยิงทั้ง LINE + webhook นี้
BOOKING_WEBHOOK_URL=

# SEO / canonical (ไม่บังคับ)
# ตั้งเป็นโดเมนจริงก่อนขึ้น production เช่น https://www.mongkonridemate.com
# ถ้าไม่ตั้ง จะ fallback เป็น https://www.mongkonridemate.com
NEXT_PUBLIC_SITE_URL=https://www.mongkonridemate.com

# ตั้งเป็น 1 เพื่อบังคับ noindex ทุกหน้า (staging / preview นอก Vercel)
NEXT_PUBLIC_NO_INDEX=